# netprobe config sample
# Copy this file to config.toml and edit for your site.
#
# Groups organise hosts in the TUI. Each group has a name and a list of hosts.
#
# Host fields:
#   name    (required) - display name
#   ip      (required) - IPv4 address
#   parent  (optional) - name of another host in the group; displays this host
#                        indented beneath it as a tree child

[settings]
poll_interval = 30          # seconds between automatic rescans
connect_timeout_ms = 2000   # TCP connect timeout per port (raise to 3000-4000 over a VPN)
max_concurrent_probes = 64  # max simultaneous TCP connects; lower to 16-32 on a flaky VPN
# ports = [80, 88, 135, 389, 443, 445, 636, 2179, 3389, 5985, 5986, 7001, 9100, 10123]
#   Override the probed TCP ports (liveness + role detection). Defaults to a
#   built-in list. Drop a port here if a firewall accepts it for every address
#   (e.g. an intercepted TCP/53) and makes shut-down hosts look online.

[[group]]
name = "Servers"
hosts = [
    { name = "HOST01", ip = "10.0.0.10" },
    { name = "VM-DC1", ip = "10.0.0.11", parent = "HOST01" },
    { name = "VM-FS1", ip = "10.0.0.12", parent = "HOST01" },
]

[[group]]
name = "Monitoring & Cameras"
hosts = [
    { name = "NVR01", ip = "10.0.0.50" },
]
